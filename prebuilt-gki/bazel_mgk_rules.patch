+
+def _gold_base(name, build):
+    return "@gki_prebuilts//kernel_aarch64" if build == "user" else ":{}_kernel_aarch64.{}".format(name, build)
+
+def _gold_base_uapi(name, build):
+    return "@gki_prebuilts//kernel-uapi-headers.tar.gz" if build == "user" else ":{}_kernel_aarch64.{}_uapi_headers".format(name, build)
+
+# the base kernel in the dist: not the prebuilt (the package takes Image from GKI's own download, and Kleaf would
+# copy the prebuilt's files outside the dist dir)
+def _gold_dist_base(name, build):
+    return [] if build == "user" else [":{}_kernel_aarch64.{}".format(name, build)]
+
+# the GKI modules for the dist: none from the prebuilt (its list need not match the source tree's; the
+# package takes GKI's system_dlkm modules as they are)
+def _gold_base_modules(name, build, modules):
+    return [] if build == "user" else [":{}_kernel_aarch64.{}/{}".format(name, build, m) for m in modules]
